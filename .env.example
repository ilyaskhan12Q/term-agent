# term-agent environment configuration placeholders
# DO NOT COMMIT ACTUAL API KEYS OR CREDENTIALS TO VERSION CONTROL

# Model Provider API Keys
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Application Configuration Overrides
TERMAGENT_LOG_LEVEL=info
TERMAGENT_CONFIG_PATH=~/.config/termagent/config.toml
TERMAGENT_MAX_WORKERS=5
